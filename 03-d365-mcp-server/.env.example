# Where the D365 CRM/ERP API lives. Default = the mock API in ../shared/mock-d365-api
D365_API_BASE=http://localhost:8000
D365_API_KEY=demo-key

# Permission scopes granted to THIS server instance: read, write, ops (comma separated)
MCP_SCOPES=read,write,ops

# Optional: Logic App HTTP trigger URL used by the trigger_approval_workflow tool
LOGIC_APP_URL=

# Audit log (JSON lines). Arguments are logged; values for keys containing "key"/"secret"/"token" are masked.
AUDIT_LOG_PATH=./audit.log
