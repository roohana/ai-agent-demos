# Azure OpenAI (leave AZURE_OPENAI_ENDPOINT empty to run in offline demo mode)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# Prefer managed identity (no key). Only set a key for local development.
AZURE_OPENAI_API_KEY=

# Access control: REQUIRE_AUTH=true expects Azure App Service "Easy Auth" (Entra ID) to inject X-MS-CLIENT-PRINCIPAL-NAME
REQUIRE_AUTH=false
ALLOWED_USERS=

# Data-leak guard: off | warn | redact | block
DLP_MODE=redact
