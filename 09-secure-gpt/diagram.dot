digraph G {
  rankdir=TB; labelloc=t; label="Secure GPT: private enterprise AI assistant"; fontsize=18; fontname="DejaVu Sans"; pad=0.4; nodesep=0.5; ranksep=0.6; splines=true; bgcolor="white";
  node [fontname="DejaVu Sans", fontsize=11, margin="0.18,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.8];
  emp [label="Employee\n(instead of public ChatGPT / Claude)", shape=box, style="rounded,filled", fillcolor="#F2F4F7", color="#667085", fontcolor="#1B1F24"];
  auth [label="Entra ID sign-in (Easy Auth)\nallow-list of approved staff", shape=box, style="rounded,filled", fillcolor="#FDE7E7", color="#B42318", fontcolor="#1B1F24"];
  web [label="Secure GPT web app\nFastAPI + chat UI\n(in the company's Azure tenant)", shape=box, style="rounded,filled", fillcolor="#DDF3EE", color="#1B7F6B", fontcolor="#1B1F24"];
  dlp [label="Data-leak guard\nredact / block emails, cards,\nID numbers, keys, passwords", shape=box, style="rounded,filled", fillcolor="#FDE7E7", color="#B42318", fontcolor="#1B1F24"];
  aoai [label="Company's Azure OpenAI deployment\nmanaged identity, private to tenant,\nnot used to train models", shape=box, style="rounded,filled", fillcolor="#DCEBFA", color="#215E99", fontcolor="#1B1F24"];
  sys [label="System prompt\n(agent.md)", shape=box, style="rounded,filled", fillcolor="#DCEBFA", color="#215E99", fontcolor="#1B1F24"];
  log [label="Metadata-only logging\nuser, turns, tokens, DLP flag\n(no conversation content)", shape=box, style="rounded,filled", fillcolor="#EBE4F7", color="#6B4BB0", fontcolor="#1B1F24"];
  ext [label="Public AI tools\n(sensitive data exposure risk)", shape=box, style="rounded,filled", fillcolor="#FDEBD9", color="#C2611B", fontcolor="#1B1F24"];
  emp -> auth [style=solid, color="#475467"];
  auth -> web [style=solid, color="#475467"];
  web -> dlp [style=solid, color="#475467", label="prompt"];
  dlp -> aoai [style=solid, color="#475467", label="clean prompt"];
  sys -> aoai [style=dashed, color="#475467"];
  aoai -> web [style=solid, color="#475467", label="answer"];
  web -> emp [style=solid, color="#475467", label="answer + notice"];
  web -> log [style=dotted, color="#475467"];
  emp -> ext [style=dotted, color="#B42318", label="replaced"];
  legend [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#F2F4F7" BORDER="1" COLOR="#667085" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">User / channel</FONT></TD></TR><TR><TD BGCOLOR="#DCEBFA" BORDER="1" COLOR="#215E99" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AI agent / model</FONT></TD></TR><TR><TD BGCOLOR="#DDF3EE" BORDER="1" COLOR="#1B7F6B" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Integration layer</FONT></TD></TR><TR><TD BGCOLOR="#FDEBD9" BORDER="1" COLOR="#C2611B" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">System of record</FONT></TD></TR><TR><TD BGCOLOR="#EBE4F7" BORDER="1" COLOR="#6B4BB0" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Data / telemetry</FONT></TD></TR><TR><TD BGCOLOR="#FDE7E7" BORDER="1" COLOR="#B42318" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Control / guardrail</FONT></TD></TR></TABLE>>];
}
