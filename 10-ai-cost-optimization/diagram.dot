digraph G {
  rankdir=TB; labelloc=t; label="AI Cost Optimization & Token Management framework"; fontsize=18; fontname="DejaVu Sans"; pad=0.4; nodesep=0.5; ranksep=0.6; splines=true; bgcolor="white";
  node [fontname="DejaVu Sans", fontsize=11, margin="0.18,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.8];
  apps [label="AI apps / agents\non Azure OpenAI deployments", shape=box, style="rounded,filled", fillcolor="#DCEBFA", color="#215E99", fontcolor="#1B1F24"];
  usage [label="Usage capture\nprompt + completion tokens,\nrequests, latency, model", shape=box, style="rounded,filled", fillcolor="#DDF3EE", color="#1B7F6B", fontcolor="#1B1F24"];
  store [label="Usage store\n(logs / table)", shape=box, style="rounded,filled", fillcolor="#EBE4F7", color="#6B4BB0", fontcolor="#1B1F24"];
  price [label="Price table\nper model", shape=box, style="rounded,filled", fillcolor="#EBE4F7", color="#6B4BB0", fontcolor="#1B1F24"];
  track [label="Token tracking +\ncost calculation", shape=box, style="rounded,filled", fillcolor="#DDF3EE", color="#1B7F6B", fontcolor="#1B1F24"];
  cmp [label="Model comparison\nquality / latency / cost\non evaluation set", shape=box, style="rounded,filled", fillcolor="#DDF3EE", color="#1B7F6B", fontcolor="#1B1F24"];
  fc [label="Cost prediction\nforecast + confidence", shape=box, style="rounded,filled", fillcolor="#DDF3EE", color="#1B7F6B", fontcolor="#1B1F24"];
  dash [label="Cost dashboards\nby app, model, prompt", shape=box, style="rounded,filled", fillcolor="#F2F4F7", color="#667085", fontcolor="#1B1F24"];
  agent [label="Cost analyst agent\n(agent.md)", shape=box, style="rounded,filled", fillcolor="#DCEBFA", color="#215E99", fontcolor="#1B1F24"];
  rec [label="Ranked recommendations\nprompt trimming, history limits,\ncaching, model selection", shape=box, style="rounded,filled", fillcolor="#E3F4DF", color="#3C8A2E", fontcolor="#1B1F24"];
  budget [label="Budget alerts", shape=box, style="rounded,filled", fillcolor="#FDE7E7", color="#B42318", fontcolor="#1B1F24"];
  apps -> usage [style=solid, color="#475467", label="every call"];
  usage -> store [style=solid, color="#475467"];
  store -> track [style=solid, color="#475467"];
  price -> track [style=solid, color="#475467"];
  track -> dash [style=solid, color="#475467"];
  track -> fc [style=solid, color="#475467"];
  fc -> budget [style=solid, color="#475467"];
  track -> cmp [style=dashed, color="#475467", label="candidates"];
  dash -> agent [style=solid, color="#475467", label="questions"];
  track -> agent [style=solid, color="#475467", label="data tool"];
  cmp -> agent [style=solid, color="#475467"];
  fc -> agent [style=solid, color="#475467"];
  agent -> rec [style=solid, color="#475467"];
  rec -> apps [style=dotted, color="#475467", label="owners apply changes"];
  legend [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#F2F4F7" BORDER="1" COLOR="#667085" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">User / channel</FONT></TD></TR><TR><TD BGCOLOR="#DCEBFA" BORDER="1" COLOR="#215E99" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AI agent / model</FONT></TD></TR><TR><TD BGCOLOR="#DDF3EE" BORDER="1" COLOR="#1B7F6B" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Integration layer</FONT></TD></TR><TR><TD BGCOLOR="#EBE4F7" BORDER="1" COLOR="#6B4BB0" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Data / telemetry</FONT></TD></TR><TR><TD BGCOLOR="#FDE7E7" BORDER="1" COLOR="#B42318" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Control / guardrail</FONT></TD></TR><TR><TD BGCOLOR="#E3F4DF" BORDER="1" COLOR="#3C8A2E" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Human step</FONT></TD></TR></TABLE>>];
}
