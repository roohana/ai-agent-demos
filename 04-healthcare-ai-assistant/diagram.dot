digraph G {
  rankdir=TB; labelloc=t; label="Healthcare AI Assistant: patient and practitioner records agent"; fontsize=18; fontname="DejaVu Sans"; pad=0.4; nodesep=0.5; ranksep=0.6; splines=true; bgcolor="white";
  node [fontname="DejaVu Sans", fontsize=11, margin="0.18,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.8];
  user [label="Clinician / admin\nplatform UI or Teams", shape=box, style="rounded,filled", fillcolor="#F2F4F7", color="#667085", fontcolor="#1B1F24"];
  agent [label="Copilot Studio agent\n(agent.md)", shape=box, style="rounded,filled", fillcolor="#DCEBFA", color="#215E99", fontcolor="#1B1F24"];
  priv [label="Privacy guardrails\nidentity check (2 identifiers),\nminimum necessary,\nno clinical advice", shape=box, style="rounded,filled", fillcolor="#FDE7E7", color="#B42318", fontcolor="#1B1F24"];
  rbac [label="User's own permissions\n(role-based access)", shape=box, style="rounded,filled", fillcolor="#FDE7E7", color="#B42318", fontcolor="#1B1F24"];
  dv [label="Dataverse tables\npractitioners, patients,\nappointments, referrals", shape=box, style="rounded,filled", fillcolor="#FDEBD9", color="#C2611B", fontcolor="#1B1F24"];
  plat [label="Dynamics 365-based healthcare\ncloud platform\n(patients, providers, payers)", shape=box, style="rounded,filled", fillcolor="#FDEBD9", color="#C2611B", fontcolor="#1B1F24"];
  flow [label="Power Automate flows\nnotifications, record updates\n(after confirmation)", shape=box, style="rounded,filled", fillcolor="#DDF3EE", color="#1B7F6B", fontcolor="#1B1F24"];
  gen [label="Generated output\nsummaries, navigation help,\ndraft letters (\"for staff review\")", shape=box, style="rounded,filled", fillcolor="#DCEBFA", color="#215E99", fontcolor="#1B1F24"];
  llm [label="Azure OpenAI", shape=box, style="rounded,filled", fillcolor="#DCEBFA", color="#215E99", fontcolor="#1B1F24"];
  esc [label="Emergency / out-of-scope\n-> human clinician", shape=box, style="rounded,filled", fillcolor="#E3F4DF", color="#3C8A2E", fontcolor="#1B1F24"];
  user -> agent [style=solid, color="#475467"];
  agent -> priv [style=solid, color="#475467"];
  priv -> rbac [style=solid, color="#475467"];
  rbac -> dv [style=solid, color="#475467", label="query"];
  dv -> plat [style=dashed, color="#475467"];
  agent -> llm [style=dashed, color="#475467"];
  dv -> gen [style=solid, color="#475467", label="record data"];
  llm -> gen [style=dashed, color="#475467"];
  gen -> user [style=solid, color="#475467", label="answer"];
  agent -> flow [style=solid, color="#475467", label="confirmed action"];
  flow -> plat [style=solid, color="#475467", label="update / notify"];
  priv -> esc [style=dotted, color="#B42318", label="urgent or clinical"];
  legend [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#F2F4F7" BORDER="1" COLOR="#667085" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">User / channel</FONT></TD></TR><TR><TD BGCOLOR="#DCEBFA" BORDER="1" COLOR="#215E99" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">AI agent / model</FONT></TD></TR><TR><TD BGCOLOR="#DDF3EE" BORDER="1" COLOR="#1B7F6B" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Integration layer</FONT></TD></TR><TR><TD BGCOLOR="#FDEBD9" BORDER="1" COLOR="#C2611B" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">System of record</FONT></TD></TR><TR><TD BGCOLOR="#FDE7E7" BORDER="1" COLOR="#B42318" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Control / guardrail</FONT></TD></TR><TR><TD BGCOLOR="#E3F4DF" BORDER="1" COLOR="#3C8A2E" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Human step</FONT></TD></TR></TABLE>>];
}
